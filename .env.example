# development enables the /dev tamper helpers and allows weak secrets. Leave it as production anywhere public.
APP_ENV=development
# Running the backend outside Docker (npm/uvicorn): your own Postgres.
DATABASE_URL=postgresql://paypilot:CHANGE_ME@localhost:5432/paypilot
# docker compose uses its bundled Postgres by default, nothing to set. Optional: change its password
# (set it before the first run, the volume keeps the old one).
# POSTGRES_PASSWORD=paypilot
# docker compose with your own Postgres instead (it must accept connections from Docker, not only localhost):
# DOCKER_DATABASE_URL=postgresql://user:pass@host.docker.internal:5432/paypilot
# production needs at least 32 random characters, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
DEMO_EMAIL=owner@paypilot.demo
# production needs at least 12 characters
DEMO_PASSWORD=change-me

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PAYPAL_SENDER_NOTE=Payment from PayPilot Shield

# LLM (Large Language Model) Configuration
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# This model runs on Groq: put Groq's base URL (https://api.groq.com/openai/v1) in LLM_BASE_URL below
# OpenAI compatible provider, leave empty for Anthropic. xAI: https://api.x.ai/v1  Groq: https://api.groq.com/openai/v1
LLM_BASE_URL=
CORS_ORIGINS=http://localhost:5173


# Host port for the frontend container (default 8080). The VPS host nginx proxies to 18001.
# FRONTEND_PORT=8081
